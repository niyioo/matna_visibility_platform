# Copy to backend/.env and fill in. Never commit the real file.

# ── Django ───────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=False
ALLOWED_HOSTS=matna.example.com
# Required for the Django admin over HTTPS (scheme included).
CSRF_TRUSTED_ORIGINS=https://matna.example.com
# Move the admin off the default URL (keep the trailing slash).
ADMIN_URL=admin/
ENABLE_API_DOCS=False
LOG_LEVEL=INFO

# ── Database (must match the root .env used by docker compose) ───────────────
DB_NAME=matna_visibility
DB_USER=matna
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── CORS: only needed when the SPA is served from a different origin ─────────
# (docker compose serves both from one origin, so this can stay as-is)
CORS_ALLOWED_ORIGINS=https://matna.example.com

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ── HTTPS (TLS terminated by a proxy in front of the web container) ─────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Only enable after confirming every subdomain serves HTTPS; hard to undo.
SECURE_HSTS_PRELOAD=False

# ── KPI thresholds (dashboard alerts) ───────────────────────────────────────
YIELD_TARGET_PERCENT=28
YIELD_CRITICAL_PERCENT=22
YIELD_MAX_PLAUSIBLE_PERCENT=40
DOWNTIME_WARNING_MINUTES=60
DOWNTIME_CRITICAL_MINUTES=180
STOCK_COVER_WARNING_DAYS=3
STOCK_COVER_CRITICAL_DAYS=1
STALE_DATA_DAYS=2

# ── Analysis windows & live refresh (the UI reads these from the API) ───────
TREND_WINDOW_DAYS=30
COMPARISON_WINDOW_DAYS=7
STOCK_COVER_BASIS_DAYS=14
MAX_RANGE_DAYS=366
LIVE_REFRESH_SECONDS=60

# ── Auth cookie (keep True; browsers accept Secure cookies on http://localhost)
AUTH_COOKIE_SECURE=True

# ── Gunicorn (optional) ─────────────────────────────────────────────────────
# GUNICORN_WORKERS=5
# GUNICORN_TIMEOUT=90
